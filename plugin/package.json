{
  "name": "dsh-remote-web-gateway",
  "version": "0.2.3",
  "description": "DSH Remote Web Gateway — DSH native plugin: one-click phone/tablet remote access to the DeepSeek Harness Web GUI via Cloudflare Quick Tunnel + QR/pairing-code pairing + device management",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "vendor/",
    "cordis.patch.yml",
    "NOTICE",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "remote-access",
    "remote-control",
    "mobile",
    "qr-code",
    "cloudflare",
    "quick-tunnel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AercherC/dsh-remote.git"
  },
  "homepage": "https://github.com/AercherC/dsh-remote",
  "bugs": {
    "url": "https://github.com/AercherC/dsh-remote/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "prebuild": "node scripts/vendor-core.mjs",
    "build": "tsc -p tsconfig.build.json && tsdown --config tsdown.config.ts && node scripts/write-client-types.mjs && node scripts/verify-client-boundary.mjs",
    "preverify": "node scripts/vendor-core.mjs",
    "verify": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "pretest": "node scripts/vendor-core.mjs",
    "test": "vitest run",
    "verify:client-boundary": "node scripts/verify-client-boundary.mjs",
    "prepack": "node scripts/verify-client-boundary.mjs"
  },
  "dependencies": {
    "http-proxy-3": "^1.23.3",
    "jose": "^6.2.8",
    "undici": "^6.28.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@types/node": "^22.20.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "18.3.7",
    "@types/react-test-renderer": "18.3.1",
    "qrcode": "1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  }
}

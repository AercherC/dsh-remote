node_modules/
.idea/
.pnpm-store/
# Build output of the repo root only. Do NOT ignore `dist/` at every depth:
# plugin/vendor/<core>/dist/ is the vendored runtime the plugin imports at load
# time (see plugin/lib/runtime.js), so it must stay tracked for git installs.
/dist/
*.tgz
coverage/
.env
*.log
.tmp/
.private/
.tools/
.claude/
.rehearsal-backup/
test-results/
playwright-report/
cloudflared/*.json
cloudflared/*.pem
cloudflared/*.cert
